body {
    margin: 0;
    font-family: 'Inter', sans-serif;
    background-color: #f9faff;
    color: #1F2933;
    line-height: 1.6;
}

/*HEADER*/
.containt_img{
    display: flex;
    align-items: center; /* logo y texto en línea */
    gap: 12px;           /* espacio entre logo y título */
}

/* Navbar */
.nav_header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0px 40px;
    background: linear-gradient(90deg, #323e5f, #44527a);
    color: #f8f9fa;
    box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    position: sticky;
    top: 0;
    z-index: 1000;
}

.nav_header::after {
    content: "";
    position: absolute;
    bottom: -20px;
    left: 0;
    width: 100%;
    height: 20px;
    background-color: #1F2933;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    z-index: -1;
/* Lista del nav */
.nav_header ul {
    margin: 0;
    padding: 0;

}

.nav_header button, a {
appearance: none;
color: #ffffff;
cursor: pointer;
font-family: Roobert,-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif,"Apple Color Emoji","Segoe UI Emoji","Segoe UI Symbol";
font-size: 16px;
font-weight: bold;
line-height: normal;
margin: 0;
min-height: 60px;
min-width: 0;
outline: none;
padding: 16px 24px;
text-align: center;
text-decoration: none;
transition: all 300ms cubic-bezier(.23, 1, 0.32, 1);
user-select: none;
-webkit-user-select: none;
touch-action: manipulation;
width: 100%;
will-change: transform;
}

.nav_header button:disabled {
  pointer-events: none;
}

.nav_header button:hover {
  color: #fff;
  background-color: #192266;
  box-shadow: rgba(0, 0, 0, 0.25) 0 8px 15px;
  transform: translateY(-2px);
}

.nav_header button:active {
  box-shadow: none;
  transform: translateY(0);
}
